# neuralls environment settings
# =============================
# This file is an explicit env-file example for `--env-file` or
# `NEURALLS_ENV_FILE`. `neuralls` does not auto-discover `.env` or `.env.local`.
#
# Precedence: os.environ > --env-file > NEURALLS_ENV_FILE > case config roots

# ── Required roots ───────────────────────────────────────────────────────────

# Root directory for raw input matrices and archives
NEURALLS_RAW_DIR=

# Root directory for generated/processed datasets
NEURALLS_PROCESSED_DIR=

# Root directory for experiment outputs (MLflow, checkpoints, figures)
NEURALLS_OUTPUT_DIR=

# ── Optional ─────────────────────────────────────────────────────────────────

# Select the env file path explicitly from the shell when you do not want to
# pass `--env-file` on every command.
# NEURALLS_ENV_FILE=/absolute/path/to/custom.env

# Select a case config implicitly for commands that start from dataset/model
# configs. Explicit `--case-config` still takes precedence.
# NEURALLS_CASE_CONFIG=/absolute/path/to/case.toml
